<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.plexusone.workloadguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/bin/workloadguard</string>
        <string>run</string>
        <string>--config</string>
        <string>/Users/YOUR_USERNAME/.config/workloadguard/config.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/workloadguard.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/workloadguard-error.log</string>
</dict>
</plist>
